# Keep line endings identical on every platform. Without this, Git on Windows checks files
# out as CRLF, which makes `prettier --check` (and byte-for-byte comparisons) fail.
* text=auto eol=lf

*.png binary
*.ico binary

# Scripture source files must stay byte-identical to the official download (their SHA-256 is
# pinned); the packaged TSV/meta are LF and must not be rewritten either.
data/scripture/source/* -text
data/scripture/*.tsv -text
data/scripture/*.meta.txt -text
