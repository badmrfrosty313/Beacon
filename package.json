{
  "name": "project-beacon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PROJECT BEACON: offline-first knowledge, evidence and resilience platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "scripture:verify": "node scripts/scripture/build-web.mjs --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:lint": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check:rust": "npm run rust:fmt && npm run rust:lint && npm run rust:test",
    "check:all": "npm run check && npm run check:rust",
    "dev:demo": "vite --mode browser-demo",
    "build:demo": "tsc --noEmit && vite build --mode browser-demo --base /Beacon/"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "fake-indexeddb": "^6.0.0"
  }
}
